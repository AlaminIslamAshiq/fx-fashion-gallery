rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && request.auth.uid == "JfLmcMg26BOJ7VNqyifMzHuV93E3";
    }

    function validCustomer() {
      return request.resource.data.customer is map
             && request.resource.data.customer.keys().hasOnly([
               "name", "phone", "address", "city", "area"
             ])
             && request.resource.data.customer.name is string
             && request.resource.data.customer.phone is string
             && request.resource.data.customer.address is string
             && request.resource.data.customer.city is string
             && request.resource.data.customer.area is string;
    }

    function validOrder() {
      return request.resource.data.keys().hasOnly([
               "id", "customer", "items", "subtotal", "deliveryCharge",
               "total", "paymentMethod", "transactionId",
               "paymentStatus", "status", "createdAt"
             ])
             && request.resource.data.id is string
             && request.resource.data.id.size() <= 100
             && request.resource.data.items is list
             && request.resource.data.items.size() > 0
             && request.resource.data.items.size() <= 100
             && request.resource.data.subtotal is number
             && request.resource.data.deliveryCharge is number
             && request.resource.data.total is number
             && request.resource.data.subtotal >= 0
             && request.resource.data.deliveryCharge >= 0
             && request.resource.data.total >= 0
             && request.resource.data.paymentMethod is string
             && request.resource.data.paymentMethod in [
               "Cash on Delivery", "bKash", "Nagad"
             ]
             && request.resource.data.transactionId is string
             && request.resource.data.transactionId.size() <= 200
             && request.resource.data.paymentStatus is string
             && request.resource.data.paymentStatus in [
               "Not Required", "Pending", "Paid", "Failed"
             ]
             && request.resource.data.status is string
             && request.resource.data.status in [
               "Pending", "Confirmed", "Processing", "Shipped",
               "Delivered", "Cancelled", "Returned"
             ]
             && request.resource.data.createdAt is string
             && validCustomer();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if validOrder();
      allow read, update, delete: if isAdmin();
    }

    match /orderTracking/{orderId} {
      allow create: if request.resource.data.keys().hasOnly([
        "id", "status", "paymentStatus", "createdAt", "updatedAt"
      ])
      && request.resource.data.id is string
      && request.resource.data.id == orderId
      && request.resource.data.status is string
      && request.resource.data.status in [
        "Pending", "Confirmed", "Processing", "Shipped",
        "Delivered", "Cancelled", "Returned"
      ]
      && request.resource.data.paymentStatus is string
      && request.resource.data.paymentStatus in [
        "Not Required", "Pending", "Paid", "Failed"
      ]
      && request.resource.data.createdAt is string
      && request.resource.data.updatedAt is string;

      allow read: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
